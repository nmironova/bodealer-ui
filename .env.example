# Server-side only. Copy to .env.local and set private values; never commit them.
BETA_PASSWORD=
# Generate a separate random secret: openssl rand -hex 32
SESSION_SECRET=
# Optional; default 604800 seconds (7 days). Valid range: 60..31536000.
SESSION_TTL_SECONDS=604800
# HTTPS required in production; HTTP loopback is allowed with next dev.
BODEALER_API_URL=https://your-backend.example
BACKEND_API_TOKEN=
